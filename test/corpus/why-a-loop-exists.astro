---
const { items = [], ratio = "1x1" } = Astro.props;
const CONTACTS = {};
---

<ul class="filter_content_list">
  {items.map((item) => {
    /* Not everything listed has somewhere of its own to lead. */
    const Element = item.href ? "a" : "div";
    return (
      <li
        class="filter_content_item"
        data-campuses={(item.campuses ?? []).join(",")}
        data-tags={(item.tags ?? []).join(",")}
        data-search={[
          item.title,
          item.meta,
          ...(item.campuses ?? []),
          ...(item.tags ?? []),
        ]
          .filter(Boolean)
          .join(" ")}
      >
        <div class="card_filter_wrap">
          <Element
            class="card_filter_element"
            href={item.href}
            data-trigger={item.href ? "hover focus" : undefined}
          >
            <span
              class:list={["card_filter_visual", `ratio-${ratio}`]}
            >
              {item.image && (
                <img
                  src={item.image}
                  alt=""
                  loading="lazy"
                  class="card_filter_image"
                />
              )}
            </span>
            <span class="card_filter_content">
              <span class="card_filter_title text-style-h6">
                {item.title}
              </span>
              {(item.subheading ||
                (!item.href && item.contacts?.length)) && (
                <span class="card_filter_row">
                  {item.subheading && (
                    <span class="card_filter_subheading text-style-small">
                      {item.subheading}
                    </span>
                  )}
                  {!item.href &&
                    item.contacts?.map(({ type, href }) => (
                      <a
                        href={href}
                        class="card_filter_contact"
                        aria-label={CONTACTS[type].label(
                          item.title,
                        )}
                      >
                        <svg
                          viewBox={CONTACTS[type].viewBox}
                          fill="currentColor"
                          aria-hidden="true"
                          class="card_filter_icon"
                        >
                          <path d={CONTACTS[type].path} />
                        </svg>
                      </a>
                    ))}
                </span>
              )}
              {item.meta && (
                <span class="card_filter_paragraph text-style-small">
                  {item.meta}
                </span>
              )}
            </span>
          </Element>
        </div>
      </li>
    );
  })}
</ul>
